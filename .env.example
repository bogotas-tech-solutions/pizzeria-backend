# Copia este archivo como .env y reemplaza los valores.
# .env NUNCA debe subirse al repositorio.

POSTGRES_DB=pizzeria
POSTGRES_USER=pizzeria
POSTGRES_PASSWORD=cambiar-esto

DB_URL=jdbc:postgresql://localhost:5432/pizzeria

# Genera una clave aleatoria de al menos 32 caracteres, por ejemplo:
#   openssl rand -base64 48
JWT_SECRET=reemplazar-por-una-clave-aleatoria-larga

CORS_ALLOWED_ORIGINS=http://localhost:5173
