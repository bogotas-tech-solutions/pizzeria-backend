# Normaliza finales de línea: LF en el repositorio para todos los archivos de texto.
* text=auto eol=lf

# Scripts de Windows necesitan CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# El wrapper de Maven para Linux/macOS/Docker DEBE tener LF o falla al ejecutarse
mvnw text eol=lf

# Binarios
*.jar binary
*.png binary
*.jpg binary
*.webp binary
